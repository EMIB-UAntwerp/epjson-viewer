  "SurfaceConvectionAlgorithm:Outside 1": {
   "algorithm": "TARP"
  }
 },
 "ShadowCalculation": {
  "ShadowCalculation 1": {
   "shading_calculation_method": "PixelCounting",
   "shading_calculation_update_frequency": 20,
   "shading_calculation_update_frequency_method": "Periodic"
  }
 },
 "Output:VariableDictionary": {
  "Output:VariableDictionary 1": {
   "key_field": "regular"
  }
 },
 "OutputControl:Table:Style": {
  "OutputControl:Table:Style 1": {
   "column_separator": "HTML"
  }
 },
