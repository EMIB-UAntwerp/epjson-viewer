{
 "Version": {
  "Version 1": {
   "version_identifier": "26.1"
  }
 },
 "SimulationControl": {
  "SimulationControl 1": {
   "do_zone_sizing_calculation": "Yes",
   "do_system_sizing_calculation": "No",
   "do_plant_sizing_calculation": "No",
   "run_simulation_for_sizing_period": "No",
   "run_simulation_for_weather_file_run_periods": "Yes",
   "do_hvac_sizing_simulation_for_sizing_periods": "No",
   "maximum_number_of_hvac_sizing_simulation_passes": 1
  }
 },
 "Timestep": {
  "Timestep 1": {
   "number_of_timesteps_per_hour": 4
  }
 },
 "GlobalGeometryRules": {
  "GlobalGeometryRules 1": {
   "coordinate_system": "Relative",
   "starting_vertex_position": "UpperLeftCorner",
   "vertex_entry_direction": "Counterclockwise"
  }
 },
 "RunPeriod": {
  "Run Period Europe": {
   "begin_day_of_month": 1,
   "begin_month": 1,
   "end_day_of_month": 31,
   "end_month": 12,
   "day_of_week_for_start_day": "Sunday",
   "use_weather_file_holidays_and_special_days": "Yes",
   "use_weather_file_daylight_saving_period": "Yes",
   "apply_weekend_holiday_rule": "No",
   "use_weather_file_rain_indicators": "Yes",
   "use_weather_file_snow_indicators": "Yes"
  }
 },
 "HeatBalanceAlgorithm": {
  "HeatBalanceAlgorithm 1": {
   "algorithm": "ConductionTransferFunction"
  }
 },
 "SurfaceConvectionAlgorithm:Inside": {
  "SurfaceConvectionAlgorithm:Inside 1": {
   "algorithm": "TARP"
  }
 },
